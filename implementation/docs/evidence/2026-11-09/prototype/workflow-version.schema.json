{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "workflowId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "input.asset",
              "comfy.execute",
              "output.asset"
            ]
          },
          "config": {
            "type": "object",
            "properties": {
              "templateId": {
                "type": "string",
                "const": "core_image_resize_v2"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "config"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "sourcePort": {
            "type": "string",
            "const": "asset"
          },
          "target": {
            "type": "string"
          },
          "targetPort": {
            "type": "string",
            "const": "asset"
          }
        },
        "required": [
          "source",
          "sourcePort",
          "target",
          "targetPort"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "projectId",
    "workflowId",
    "version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
