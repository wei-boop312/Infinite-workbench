{
  "name": "ai-commerce-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.19.0" },
  "scripts": {
    "local:dev": "tsx tools/local-workspace.ts",
    "dev": "pnpm --filter @canvas/web dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
