{
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "../api/src/**/*.ts", "../../packages/*/src/**/*.ts"],
  "exclude": ["../../packages/**/*.test.ts"]
}
